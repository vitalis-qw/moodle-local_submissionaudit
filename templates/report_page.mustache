{{!
    @template local_submissionaudit/report_page

    Audit report of one assignment: one row per student and check.

    Context variables required for this template:
    * title - page heading
    * hasrows - whether there is anything to show
    * rows - list of {studentname, studenturl, check, status, badge, score, message, time}
    * noresults - text shown when rows is empty

    Example context (json):
    {
        "title": "Submission audit: Essay 1",
        "hasrows": true,
        "noresults": "No audited submissions yet.",
        "rows": [
            {"studentname": "Ann Student", "studenturl": "#", "check": "Minimum words", "status": "Fail",
             "badge": "badge bg-danger", "score": "12.00", "message": "Only 12 words, minimum 25.", "time": "4 Nov 2026, 10:00"}
        ]
    }
}}
<h2>{{title}}</h2>
{{#hasrows}}
<table class="table generaltable local-submissionaudit-report">
    <thead>
        <tr>
            <th scope="col">{{#str}} col:student, local_submissionaudit {{/str}}</th>
            <th scope="col">{{#str}} col:check, local_submissionaudit {{/str}}</th>
            <th scope="col">{{#str}} col:status, local_submissionaudit {{/str}}</th>
            <th scope="col">{{#str}} col:score, local_submissionaudit {{/str}}</th>
            <th scope="col">{{#str}} col:message, local_submissionaudit {{/str}}</th>
            <th scope="col">{{#str}} col:time, local_submissionaudit {{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
        <tr>
            <td><a href="{{studenturl}}">{{studentname}}</a></td>
            <td>{{check}}</td>
            <td><span class="{{badge}}">{{status}}</span></td>
            <td>{{score}}</td>
            <td>{{{message}}}</td>
            <td>{{time}}</td>
        </tr>
        {{/rows}}
    </tbody>
</table>
{{/hasrows}}
{{^hasrows}}
<div class="alert alert-info" role="alert">{{noresults}}</div>
{{/hasrows}}
